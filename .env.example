# Copia este archivo a .env y completa los valores.
#   cp .env.example .env
#
# Genera los dos secretos con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Servidor -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
PUBLIC_URL=http://localhost:3001
LOG_LEVEL=info

# --- Persistencia -------------------------------------------------------------
DATABASE_PATH=./data/manteiner.db
ARTIFACTS_DIR=./data/artifacts

# --- Secretos (OBLIGATORIOS: la API no arranca sin ellos) ---------------------
# 32 bytes en base64. Cifra las credenciales de proveedores de IA en reposo.
MASTER_KEY=
# Firma la cookie de sesion. Minimo 32 caracteres.
SESSION_SECRET=

# --- GitHub (Fase 2 y 3; todavia no se usan) ----------------------------------
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# --- Ejecucion de agentes (Fase 5; todavia no se usan) ------------------------
# AGENT_IMAGE=manteiner-agent:0.1.0
# GIT_IMAGE=manteiner-git:0.1.0
# WORKSPACE_BACKEND=disk
# MAX_REPO_SIZE_KB=2000000
