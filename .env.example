# Copia este archivo a .env y completa los valores.
#   cp .env.example .env
#
# Genera los dos secretos con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Servidor -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:5173
# En produccion ambas deben tener el mismo origen publico; un reverse proxy envia /api a Fastify.
LOG_LEVEL=info

# --- Persistencia -------------------------------------------------------------
DATABASE_PATH=./data/manteiner.db
ARTIFACTS_DIR=./data/artifacts

# --- Docker -------------------------------------------------------------------
# Dockerode detecta DOCKER_HOST o el socket local. Usa esto solo para sobrescribirlo.
# Windows: //./pipe/docker_engine. Linux tradicional: /var/run/docker.sock.
# DOCKER_SOCKET=/var/run/docker.sock
DOCKER_API_TIMEOUT_MS=3000
GIT_IMAGE=manteiner-git:0.1.0
MAX_REPO_SIZE_KB=2000000
CLONE_TIMEOUT_MS=300000
# Contenedor de publicacion del PR (commit + push de la rama manteiner/*).
PUBLISH_TIMEOUT_MS=180000
PROVIDER_HTTP_TIMEOUT_MS=10000
OAUTH_DEVICE_TIMEOUT_MS=900000
RUN_TIMEOUT_MS=1800000
REFRESH_MARGIN_MS=300000
AGENT_IMAGE=manteiner-agent:0.1.0
PROVIDER_CATALOG_PATH=./data/provider-catalog.json
PROVIDER_CATALOG_MAX_AGE_MS=86400000
PROVIDER_STARTUP_TIMEOUT_MS=30000
PROVIDER_OPERATION_TIMEOUT_MS=120000

# Fase 5 - contenedor del agente
# Cuanto se espera a que opencode responda el healthcheck tras arrancar.
CONTAINER_START_TIMEOUT_MS=60000
# Crear/arrancar/borrar contenedores es mucho mas lento que un inspect: van
# separados para que un borrado lento no tire abajo un run que ya termino.
DOCKER_LIFECYCLE_TIMEOUT_MS=60000
# Limites del contenedor del agente. Un repo grande con muchas dependencias
# puede necesitar mas memoria; si el run muere con CONTAINER_OOM, subilo.
AGENT_MEMORY_MB=2048
AGENT_CPUS=2

# --- Secretos (OBLIGATORIOS: la API no arranca sin ellos) ---------------------
# 32 bytes en base64. Cifra las credenciales de proveedores de IA en reposo.
MASTER_KEY=
# Firma y cifra los artefactos internos de Better Auth. Minimo 32 caracteres.
SESSION_SECRET=

# --- GitHub OAuth (login; obligatorio) ----------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (instalacion y repositorios; obligatorio) ---------------------
# Permisos: metadata R, contents RW, pull requests RW y organization members R.
GITHUB_API_TIMEOUT_MS=10000
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Contenido completo del .pem codificado en base64.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("private-key.pem"))
GITHUB_APP_PRIVATE_KEY_BASE64=

# --- GitHub webhooks (pendiente) ----------------------------------------------
# GITHUB_WEBHOOK_SECRET=

# --- Ejecucion de agentes (Fase 5; todavia no se usan) ------------------------
# WORKSPACE_BACKEND=disk
# MAX_CONCURRENT_RUNS=2
