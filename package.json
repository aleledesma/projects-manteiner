{
  "name": "manteiner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditorias de mantenimiento de repositorios ejecutadas por un agente de IA en contenedores efimeros",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @manteiner/api",
    "dev:web": "npm run dev --workspace @manteiner/web",
    "build": "npm run build --workspaces --if-present",
    "docker:build:git": "docker build --tag manteiner-git:0.1.0 docker/git",
    "docker:build:agent": "docker build --tag manteiner-agent:0.1.0 --file docker/agent/Dockerfile .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
