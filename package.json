{
  "name": "manteiner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditorias de mantenimiento de repositorios ejecutadas por un agente de IA en contenedores efimeros",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @manteiner/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
